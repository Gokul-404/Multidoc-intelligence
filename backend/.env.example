# ── SentinelRAG Environment Configuration ──────────────────────────────────

# LLM Provider: "groq" (default) or "gemini"
LLM_PROVIDER=groq

# Groq API Configuration (Free, ultra-fast LPU inference: https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings: "fastembed" (local, free, no API key needed) or "gemini"
EMBEDDING_PROVIDER=fastembed

# (Optional) Google Gemini Configuration (if using Gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
API_KEY=sentinel-dev-key-change-in-production
